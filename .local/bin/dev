#!/usr/bin/env bash
# nvim top-left, shell bottom-left (20% height), spare shell right (25% width)
if [[ -z $TMUX ]]; then
    echo "dev: must be run inside tmux" >&2
    exit 1
fi

editor=$(tmux display -p '#{pane_id}')
right=$(tmux split-window -h -l 25% -P -F '#{pane_id}')
bottom=$(tmux split-window -v -l 20% -t "$editor" -P -F '#{pane_id}')

# tmux spreads resizes evenly across panes, so re-apply the ratios (errors ignored for closed panes)
tmux set-hook -w window-resized \
    "run-shell -b 'tmux resize-pane -t $right -x 25% 2>/dev/null; tmux resize-pane -t $bottom -y 20% 2>/dev/null; true'"

tmux send-keys -t "$editor" 'nvim' C-m
tmux select-pane -t "$bottom"
