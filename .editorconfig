# EditorConfig for the dotfiles repo itself (editing via ~/.dotfiles/...).
# .config/.editorconfig is the stowed twin for ~/.config/... paths.
# Keep both files in sync.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Lua (Neovim, Hyprland)
[*.lua]
indent_style = space
indent_size = 4

# TOML (mise)
[*.toml]
indent_style = space
indent_size = 4

# Conf files (tmux)
[*.conf]
indent_style = space
indent_size = 4

# Markdown
[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false