[core]
    autocrlf = input

[commit]
    verbose = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[diff]
    algorithm = histogram
    colorMoved = default

[rebase]
    autoStash = true
    updateRefs = true

[branch]
    sort = -committerdate

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[init]
    defaultBranch = main

[alias]
    lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
    gone = ! git fetch && git for-each-ref refs/heads --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' | xargs -r -n 1 git branch -D

# Per-machine overrides, untracked
[include]
    path = config.local
