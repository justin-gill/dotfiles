# Base git config (tracked) -- shared defaults for every machine.
# Two levels, lowest precedence first:
#   1. this file     -- shared defaults, tracked in the dotfiles repo
#   2. config.local  -- per-machine overrides, untracked (git-ignored)

[core]
    autocrlf = input

[commit]
    verbose = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[init]
    defaultBranch = main

[alias]
    lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
    gone = ! git fetch && git for-each-ref refs/heads --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%(end)' | xargs -r -n 1 git branch -D

[include]
    path = config.local
