# XDG git config, remove ~/.gitconfig if exists so git will fallback here

[include]
    path = user.gitconfig # for local [user] block

[core]
    autocrlf = input

[commit]
    verbose = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[init]
    defaultBranch = main

[alias]
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
    up = pull --rebase --autostash origin main
    gone = ! "git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D"
